# Database
SPRING_DATASOURCE_PASSWORD=change_me

# AI Provider - Groq (FREE) - Get key at https://console.groq.com
# Also compatible with OpenAI if you prefer (just change the models)
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_SUMMARY_MODEL=openai/gpt-oss-120b

# Instagram / Meta application configuration (owned by the deployment operator)
# Connect exactly one Main Professional account. End users can DM it from normal personal accounts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_verify_token
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8085/api/instagram/oauth/callback
INSTAGRAM_FRONTEND_REDIRECT_URI=http://localhost:3002/instagram
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_WEBHOOK_SIGNATURE_REQUIRED=true

# Redis hot cache (PostgreSQL remains the source of truth)
REDIS_HOST=localhost
REDIS_PORT=6379
REEL_CACHE_TTL=PT24H

# Legacy single-account fallback (normally leave empty when OAuth is enabled)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Security
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Media
MAX_MEDIA_SIZE_MB=100

# Frontend
FRONTEND_ORIGIN=http://localhost:3002

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
